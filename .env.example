# ============================================================
# CRIS OS - Exemplo de variáveis de ambiente
# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo .env para o GitHub (ele está no .gitignore).
# ============================================================

# --- Telegram ---
# Token do seu bot, gerado pelo @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=coloque_aqui_o_token_do_botfather

# Seu ID numérico de usuário no Telegram (para o bot só responder a você).
# Descubra o seu mandando uma mensagem para o @userinfobot.
# Deixe vazio para o bot responder a qualquer pessoa (NÃO recomendado).
TELEGRAM_ALLOWED_USER_ID=

# Chat ID do Telegram para notificações (opcional).
# Usado pelo StudioNotifier para enviar notificações de confirmação.
# Deixe vazio se não precisar de notificações proativas.
TELEGRAM_CHAT_ID=

# --- NVIDIA AI (provedor remoto) ---
# Chave de API da NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=COLE_SUA_CHAVE_AQUI
# URL base da API (compatível com OpenAI)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Modelo rápido para roteamento e classificação (NVIDIA_ROUTER_MODEL)
NVIDIA_ROUTER_MODEL=meta/llama-3.1-8b-instruct
# Modelo forte para geração de conteúdo (NVIDIA_GENERATION_MODEL)
NVIDIA_GENERATION_MODEL=meta/llama-3.1-70b-instruct
# Máx mensagens de histórico enviadas ao provedor de roteamento
ROUTER_CONTEXT_MESSAGES=3
# (legado) Modelo padrão — usado como GENERATION se NVIDIA_GENERATION_MODEL não existir
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# --- Ollama (IA local) ---
# Endereço do servidor Ollama rodando na sua máquina.
OLLAMA_HOST=http://localhost:11434

# Modelo que será usado por padrão. Exemplos: llama3.1, llama3.2, qwen2.5, mistral.
# Rode "ollama list" no terminal para ver os modelos que você já baixou.
OLLAMA_MODEL=llama3.1

# Tempo máximo (segundos) para esperar a resposta do modelo local.
OLLAMA_TIMEOUT=120

# Controle de GPU do Ollama (opcional):
#   vazio = automático (Ollama decide)
#   0     = força CPU (use se sua GPU der "CUDA out of memory")
#   N     = nº de camadas na GPU
# Mesmo no automático, há fallback para CPU quando ocorrer "CUDA out of memory".
OLLAMA_NUM_GPU=

# --- CRIS OS ---
# Modo de operacao dos agentes:
#   "auto"  = orquestrador escolhe o melhor agente para cada mensagem
#   "secretary" = agente fixo (secretaria, comportamento anterior)
DEFAULT_AGENT=auto

# Nível de log: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# Quantidade de mensagens antigas que a IA "lembra" em cada conversa.
MEMORY_CONTEXT_MESSAGES=12

# Tempo de vida (segundos) do "lease" de líder (eleição p/ 2ª máquina).
LEASE_TTL_SECONDS=60

# --- ODS (Osmantic Deployment System) ---
# Habilita/desabilita a integração com o ODS.
ODS_ENABLED=true

# URL base do Ollama gerenciado pelo ODS (porta padrão Linux Docker).
ODS_BASE_URL=http://localhost:11434

# URL alternativa do Ollama (porta nativa Windows/macOS via llama-server).
ODS_FALLBACK_URL=http://localhost:8080

# URL do Open WebUI (interface web do ODS).
ODS_WEBUI_URL=http://localhost:3000

# Timeout em segundos para requisições ao ODS.
ODS_TIMEOUT=120

# Modelo LLM: "auto" para detectar automaticamente, ou nome específico.
ODS_MODEL=auto

# --- Fallback: OpenAI (API compatível, ex.: OpenAI, Together, DeepSeek) ---
# Preencha somente se quiser fallback para OpenAI quando ODS estiver offline.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# --- Fallback: Google Gemini ---
# Preencha somente se quiser fallback para Gemini quando ODS estiver offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Provedor de fallback quando ODS está offline ---
# Opções: "nvidia" (padrão), "openai", "gemini", "anthropic"
ODS_FALLBACK_PROVIDER=nvidia

# --- Camada de cognição (planejamento/execução/supervisão) ---
# Mantenha FALSE: a camada já faz parte da arquitetura, mas ainda é esqueleto.
COGNITION_ENABLED=false
EXECUTION_DEFAULT_TIMEOUT=120
EXECUTION_MAX_RETRIES=1
QUALITY_MIN_SCORE=0.7
MAX_REVISIONS=2
