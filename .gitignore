# ============================================================
# CRIS OS - .gitignore
# ============================================================

# Segredos / configuração local
.env

# Banco de dados / dados gerados em tempo de execução
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
backups/*
!backups/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# Sistema operacional / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / frontend (build artifacts — regeneraveis via npm install + npm run build)
node_modules/
web/frontend/dist/

# Agentes criados no Studio (dados de runtime do Agent Builder)
agent_builder/agents_studio/
